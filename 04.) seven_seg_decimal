module seven_seg_decimal(
    input clk,
    input [7:0] value,
    output reg [6:0] seg,
    output reg [3:0] an
);

    reg [1:0] digit = 0;
    reg [3:0] num;
    reg [16:0] refresh = 0;

    always @(posedge clk) begin
        refresh <= refresh + 1;
        if (refresh == 100000) begin
            refresh <= 0;
            digit <= digit + 1;
        end
    end

    always @(*) begin
        case(digit)
            0: begin an = 4'b1110; num = value % 10; end
            1: begin an = 4'b1101; num = (value / 10) % 10; end
            2: begin an = 4'b1011; num = (value / 100) % 10; end
            3: begin an = 4'b0111; num = (value / 1000) % 10; end
        endcase

        case(num)
            0: seg = 7'b1000000;
            1: seg = 7'b1111001;
            2: seg = 7'b0100100;
            3: seg = 7'b0110000;
            4: seg = 7'b0011001;
            5: seg = 7'b0010010;
            6: seg = 7'b0000010;
            7: seg = 7'b1111000;
            8: seg = 7'b0000000;
            9: seg = 7'b0010000;
            default: seg = 7'b1111111;
        endcase
    end
endmodule
