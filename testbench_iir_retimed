`timescale 1ns/1ps

module tb_iir_filter_retimed;

reg clk;
reg rst;
reg [3:0] x_in;
wire signed [15:0] y_out;

iir_filter_retimed uut (
    .clk(clk),
    .rst(rst),
    .x_in(x_in),
    .y_out(y_out)
);

// Clock generation
initial clk = 0;
always #5 clk = ~clk;

// Stimulus
initial begin
    rst = 1;
    x_in = 4;   // constant input

    #20 rst = 0;

    #500 $finish;
end

endmodule
